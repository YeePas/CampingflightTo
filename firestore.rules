rules_version = '2';

// =============================================================================
// CampingflightTo Firestore rules
// =============================================================================
//
// Security model:
//   - Group CREATION is admin-only (server-side API + Firebase Admin SDK).
//     Client-side `create` on /groups/* is blocked by these rules.
//   - Group READ + UPDATE (e.g. add a member) is open: anyone who knows the
//     group's invite code can join.
//   - App DATA inside /groups/{id}/data/* is open to anyone who knows the
//     group id (i.e. who has joined the group).
//
// To deploy:
//   Firebase Console → Firestore Database → Rules tab → paste this file → Publish

service cloud.firestore {
  match /databases/{database}/documents {

    // Group metadata
    match /groups/{groupId} {
      allow read: if true;          // anyone can look up a group (needed to validate invite code)
      allow update: if true;        // anyone can add themselves as a member after joining
      allow create: if false;       // creation is admin-only (via /api/admin/create-group)
      allow delete: if false;       // deletion is admin-only (not currently exposed)

      // App data — paklijst, tips, locations, etc.
      match /data/{docId} {
        allow read, write: if true;
      }
    }

    // Legacy paths — kept readable so the one-time migration can copy data
    // across. Safe to remove this block once migration has run on all devices.
    match /camping/{docId} {
      allow read, write: if true;
    }
  }
}
